# REQUIRED: your fal.ai API key. Keep server-side only.
FAL_KEY=

# A long random secret used to sign WGM Video OAuth tokens.
WGM_OAUTH_SECRET=

# Optional: public URL of the deployment, e.g. https://wgm-video.vercel.app
WGM_PUBLIC_URL=

# Optional safety cap in USD. WGM will refuse a requested estimated cost above this value.
WGM_MAX_ESTIMATED_COST_USD=1.50